[Unit]
Description=Omarchy Kids parent control broker
After=local-fs.target
ConditionPathExists=/var/lib/omarchy-kids-control/pin.json

[Service]
Type=simple
ExecStart=/usr/local/lib/omarchy-kids/run control
User=root
UMask=0077
RuntimeDirectory=omarchy-kids-control
RuntimeDirectoryMode=0755
StateDirectory=omarchy-kids-control
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/share/omarchy-kids/applications /etc/chromium/policies/managed
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
